from collections import deque
import heapq

# Graph with distances (km)

graph = {
    "College": [("Metro Station", 0.5), ("N D Savla", 0.9)],

    "Metro Station": [("Gundavali", 0.6)],

    "Gundavali": [("Andheri East", 0.7)],

    "Andheri East": [("MIDC Central Road", 0.8)],

    "N D Savla": [("Paper Box Junction", 0.7)],

    "Paper Box Junction": [("MIDC Central Road", 0.9)],

    "MIDC Central Road": [("Home", 0.7)],

    "Home": []
}

# Heuristic values

heuristic = {
    "College": 3.3,
    "Metro Station": 2.8,
    "Gundavali": 2.2,
    "Andheri East": 1.5,
    "MIDC Central Road": 0.7,
    "N D Savla": 2.5,
    "Paper Box Junction": 1.6,
    "Home": 0
}

# Calculate path cost

def get_cost(path):
    cost = 0
    for i in range(len(path)-1):
        for n, c in graph[path[i]]:
            if n == path[i+1]:
                cost += c
    return cost


# BFS

def bfs(start, goal):
    q = deque([(start, [start])])
    visited = set()
    explored = 0

    while q:
        node, path = q.popleft()

        if node not in visited:
            visited.add(node)
            explored += 1

            if node == goal:
                return path, get_cost(path), explored

            for nxt, _ in graph[node]:
                q.append((nxt, path+[nxt]))


# DFS

def dfs(start, goal):
    stack = [(start,[start])]
    visited = set()
    explored = 0

    while stack:
        node,path = stack.pop()

        if node not in visited:
            visited.add(node)
            explored += 1

            if node == goal:
                return path,get_cost(path),explored

            for nxt,_ in reversed(graph[node]):
                stack.append((nxt,path+[nxt]))


# UCS

def ucs(start,goal):

    pq=[(0,start,[start])]
    visited=set()
    explored=0

    while pq:

        cost,node,path=heapq.heappop(pq)

        if node not in visited:

            visited.add(node)
            explored+=1

            if node==goal:
                return path,cost,explored

            for nxt,c in graph[node]:
                heapq.heappush(pq,(cost+c,nxt,path+[nxt]))


# Greedy Best First Search

def greedy(start,goal):

    pq=[(heuristic[start],start,[start])]
    visited=set()
    explored=0

    while pq:

        h,node,path=heapq.heappop(pq)

        if node not in visited:

            visited.add(node)
            explored+=1

            if node==goal:
                return path,get_cost(path),explored

            for nxt,_ in graph[node]:
                heapq.heappush(pq,(heuristic[nxt],nxt,path+[nxt]))


# A*

def astar(start,goal):

    pq=[(heuristic[start],0,start,[start])]
    visited=set()
    explored=0

    while pq:

        f,g,node,path=heapq.heappop(pq)

        if node not in visited:

            visited.add(node)
            explored+=1

            if node==goal:
                return path,g,explored

            for nxt,c in graph[node]:
                newg=g+c
                newf=newg+heuristic[nxt]

                heapq.heappush(pq,(newf,newg,nxt,path+[nxt]))


algorithms = [
    ("Breadth First Search", bfs),
    ("Depth First Search", dfs),
    ("Uniform Cost Search", ucs),
    ("Greedy Best First Search", greedy),
    ("A* Search", astar)
]

for name, algo in algorithms:

    path, cost, explored = algo("College", "Home")

    print("\n", "="*50)
    print(name)
    print("Path :", " -> ".join(path))
    print("Distance :", cost, "km")
    print("Nodes Explored :", explored)
